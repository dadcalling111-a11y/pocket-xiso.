
name: Build and Deploy Pocket XISO

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Extract source archive
        run: unzip pocket-xiso-android-source.zip -d source

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          toolchain: stable
          targets: wasm32-unknown-unknown

      - name: Install Trunk
        uses: jetli/trunk-action@v0.5.0
        with:
          version: latest

      - name: Build web application
        working-directory: source/xdvdfs-0.8.3/xdvdfs-web
        run: trunk build --release --public-url "/${{ github.event.repository.name }}/"

      - name: Upload website
        uses: actions/upload-pages-artifact@v3
        with:
          path: source/xdvdfs-0.8.3/xdvdfs-web/dist

  deploy:
    runs-on: ubuntu-latest
    needs: build
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v4
